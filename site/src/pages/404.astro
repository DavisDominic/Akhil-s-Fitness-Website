---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { trialHref, trialLabel } from '../data/site';
---
<Base title="Page not found | Akhil’s Fitness Coaching" noindex>
  <section class="section flush" style="text-align:center;padding-block:var(--sp-11)">
    <div class="container">
      <p class="t-display" style="font-size:clamp(88px,26vw,200px);color:var(--accent-500)" aria-hidden="true">404</p>
      <h1 class="t-h3 mtop-1">That page <span>isn’t here.</span></h1>
      <p class="sec mtop-2" style="margin-inline:auto;max-width:36ch">Head back home, or book your free trial.</p>
      <div class="row mtop-3" style="justify-content:center">
        <Button href="/">Go home</Button>
        <Button href={trialHref} variant="secondary">{trialLabel()}</Button>
      </div>
    </div>
  </section>
</Base>
