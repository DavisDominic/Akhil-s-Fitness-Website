---
import '../styles/global.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/manrope/latin-800.css';
import barlow800 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url';
import manrope400 from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';
import manrope700 from '@fontsource/manrope/files/manrope-latin-700-normal.woff2?url';
import IconSprite from '../components/ui/IconSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Overrides the site-wide default (noindex until `site.indexable` is true). */
  noindex?: boolean;
  current?: 'home' | 'about' | 'connect';
  /** Sticky mobile CTA bar: Home and About only (DS §07). */
  bar?: boolean;
  /** Dev/utility pages render without the site shell. */
  bare?: boolean;
}
const {
  title,
  description = 'Personalised, hands-on personal training in apartment society gyms. Build fitness that lasts.',
  noindex = !site.indexable,
  current,
  bar = false,
  bare = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <!-- Runs before body content parses, not in src/scripts/motion.ts: the testimonial marquee's duplicated
         "loop" cards need to be display:none for iOS from this element's very FIRST layout (see the .ios rule
         in layout.css) — removing them via JS *after* the browser has already committed an initial layout with
         all of them present risked iOS's scroll container caching stale scroll bounds from that first commit,
         which read as scrolling into empty space past the real content with nothing there to stop it. -->
    <script is:inline>
      if (/iP(hone|od|ad)/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
        document.documentElement.classList.add('ios');
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080809" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={barlow800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manrope400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manrope700} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <IconSprite />
    <a class="skip" href="#main">Skip to content</a>
    {!bare && <Header current={current} />}
    <main id="main"><slot /></main>
    {!bare && (
      <Footer hasCta={Astro.slots.has('cta')}>
        <Fragment slot="cta"><slot name="cta" /></Fragment>
      </Footer>
    )}
    {!bare && bar && <StickyBar />}
    <script>
      import '../scripts/source';
      import '../scripts/motion';
    </script>
  </body>
</html>
<style is:global>
  .skip{position:absolute;left:8px;top:-60px;z-index:var(--z-toast);background:var(--accent-500);color:var(--ink-950);font-weight:700;padding:12px 16px;border-radius:var(--r-sm);text-decoration:none}
  .skip:focus{top:8px}
</style>
